# Generated by brasilia-night Theme Engine — DO NOT EDIT MANUALLY
# Variant: {{VARIANT}} | Accent: {{ACCENT_NAME}} ({{ACCENT}})

"$schema" = 'https://starship.rs/config-schema.json'

format = """
[╭─](fg:{{BORDER}})\
$directory\
$git_branch\
$git_status\
$python\
$c\
$java\
$golang\
$nodejs\
$rust\
$lua\
$docker_context\
$cmd_duration\
$line_break\
[╰─](fg:{{BORDER}})$character"""

add_newline = true
command_timeout = 800
 scan_timeout = 30
palette = "brasilia_night"

[palettes.brasilia_night]
background = "{{BACKGROUND}}"
background_alt = "{{BACKGROUND_ALT}}"
surface = "{{SURFACE}}"
surface_alt = "{{SURFACE_ALT}}"
foreground = "{{FOREGROUND}}"
foreground_muted = "{{FOREGROUND_MUTED}}"
foreground_subtle = "{{FOREGROUND_SUBTLE}}"
accent = "{{ACCENT}}"
accent_secondary = "{{ACCENT_SECONDARY}}"
border = "{{BORDER}}"
success = "{{SUCCESS}}"
warning = "{{WARNING}}"
error = "{{ERROR}}"
info = "{{INFO}}"

[character]
success_symbol = "[▸](bold fg:accent)"
error_symbol = "[▸](bold fg:error)"
vimcmd_symbol = "[◂](bold fg:success)"

[directory]
style = "bold fg:accent"
format = "[ $path ]($style)[$read_only]($read_only_style)"
truncation_length = 4
truncation_symbol = "…/"
read_only = "  "
read_only_style = "fg:error"

[git_branch]
symbol = " "
style = "fg:accent_secondary"
format = "[│ $symbol$branch ]($style)"

[git_status]
style = "fg:warning"
format = '([$all_status$ahead_behind ]($style))'
conflicted = "="
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
untracked = "?${count}"
stashed = "*${count}"
modified = "!${count}"
staged = "+${count}"
renamed = "»${count}"
deleted = "✘${count}"

[python]
symbol = " "
style = "fg:info"
format = '[│ ${symbol}${pyenv_prefix}(${version} )(\($virtualenv\) )]($style)'

[c]
symbol = " "
style = "fg:foreground_muted"
format = '[│ $symbol($version(-$name) )]($style)'
detect_extensions = ["c", "h"]

[java]
symbol = " "
style = "fg:warning"
format = '[│ $symbol($version )]($style)'

[golang]
symbol = " "
style = "fg:info"
format = '[│ $symbol($version )]($style)'

[nodejs]
symbol = " "
style = "fg:success"
format = '[│ $symbol($version )]($style)'

[rust]
symbol = " "
style = "fg:warning"
format = '[│ $symbol($version )]($style)'

[lua]
symbol = " "
style = "fg:accent_secondary"
format = '[│ $symbol($version )]($style)'

[docker_context]
symbol = " "
style = "fg:info"
format = '[│ $symbol$context ]($style)'
only_with_files = true

[cmd_duration]
min_time = 2000
style = "fg:foreground_subtle"
format = "[│ ⏱ $duration ]($style)"
