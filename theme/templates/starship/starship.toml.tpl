# Generated by nocturne Theme Engine (Arch WSL Context) — DO NOT EDIT MANUALLY
# Variant: {{VARIANT}} | Accent: {{ACCENT_NAME}} ({{ACCENT}})

"$schema" = 'https://starship.rs/config-schema.json'

format = """
$directory\
$git_branch\
$git_status\
$cmd_duration\
$line_break\
$character"""

add_newline = true
command_timeout = 800
scan_timeout = 30
palette = "nocturne"

[palettes.nocturne]
background = "{{BACKGROUND}}"
background_alt = "{{BACKGROUND_ALT}}"
surface = "{{SURFACE}}"
surface_alt = "{{SURFACE_ALT}}"
foreground = "{{FOREGROUND}}"
foreground_muted = "{{FOREGROUND_MUTED}}"
foreground_subtle = "{{FOREGROUND_SUBTLE}}"
accent = "{{ACCENT}}"
accent_blue = "{{ACCENT_BLUE}}"
accent_purple = "{{ACCENT_PURPLE}}"
accent_secondary = "{{ACCENT_SECONDARY}}"
border = "{{BORDER}}"
success = "{{SUCCESS}}"
warning = "{{WARNING}}"
error = "{{ERROR}}"
info = "{{INFO}}"

[character]
success_symbol = "[❯](bold fg:accent_blue)"
error_symbol = "[❯](bold fg:error)"
vimcmd_symbol = "[❮](bold fg:success)"

[directory]
style = "bold fg:foreground"
format = "[$path]($style)[$read_only]($read_only_style)  "
truncation_length = 4
truncate_to_repo = false
truncation_symbol = "…/"
read_only = " [ro]"
read_only_style = "fg:error"

[git_branch]
symbol = ""
style = "bold fg:accent_blue"
format = "on [$branch]($style)"

[git_status]
style = "bold fg:warning"
format = '( [$all_status$ahead_behind]($style))'
conflicted = "="
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕"
untracked = "?"
stashed = "$"
modified = "*"
staged = "+"
renamed = "»"
deleted = "✘"

[cmd_duration]
min_time = 2000
style = "fg:foreground_subtle"
format = "  [$duration]($style)"
