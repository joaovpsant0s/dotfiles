# Generated by nocturne Theme Engine (Windows PowerShell Context) — DO NOT EDIT MANUALLY
# Variant: {{VARIANT}} | Accent: {{ACCENT_NAME}} ({{ACCENT}})

"$schema" = 'https://starship.rs/config-schema.json'

format = """
${env_var.NOCTURNE_ADMIN}\
$directory\
$git_branch\
$git_status\
$cmd_duration\
$line_break\
$character"""

add_newline = true
command_timeout = 800
scan_timeout = 30
palette = "nocturne_pwsh"

[palettes.nocturne_pwsh]
background_alt = "{{BACKGROUND_ALT}}"
surface_alt = "{{SURFACE_ALT}}"
foreground = "{{FOREGROUND}}"
foreground_muted = "{{FOREGROUND_MUTED}}"
foreground_subtle = "{{FOREGROUND_SUBTLE}}"
accent = "{{ACCENT}}"
accent_blue = "{{ACCENT_BLUE}}"
accent_purple = "{{ACCENT_PURPLE}}"
warning = "{{WARNING}}"
error = "{{ERROR}}"

[env_var.NOCTURNE_ADMIN]
variable = "NOCTURNE_ADMIN"
style = "bold fg:warning"
format = "[$env_value ]($style)"

[character]
success_symbol = "[❯](bold fg:accent_purple)"
error_symbol = "[❯](bold fg:error)"
vimcmd_symbol = "[❮](bold fg:accent_blue)"

[directory]
style = "bold fg:foreground bg:surface_alt"
format = "[ ⊞ ](bold fg:background_alt bg:accent_purple)[ $path ]($style)[$read_only]($read_only_style)  "
truncation_length = 4
truncate_to_repo = false
truncation_symbol = "…\\"
read_only = " [ro]"
read_only_style = "fg:error"

[git_branch]
symbol = ""
style = "bold fg:accent_purple"
format = "[↳ $branch]($style)"

[git_status]
style = "bold fg:warning"
format = '( [$all_status$ahead_behind]($style))'
conflicted = "="
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕"
untracked = "?"
stashed = "$"
modified = "*"
staged = "+"
renamed = "»"
deleted = "✘"

[cmd_duration]
min_time = 2000
style = "fg:foreground_subtle"
format = "  [$duration]($style)"
