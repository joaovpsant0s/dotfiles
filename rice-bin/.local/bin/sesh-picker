#!/usr/bin/env bash
# =============================================================================
# NOCTURNE — SESH PICKER (Tmux + Zoxide + FZF Session Manager)
# =============================================================================
set -euo pipefail

collect_candidates() {
  if command -v tmux >/dev/null 2>&1; then
    tmux list-sessions -F "[tmux] #S" 2>/dev/null || true
  fi
  {
    if command -v zoxide >/dev/null 2>&1; then
      zoxide query -l 2>/dev/null | head -n 30 || true
    fi
    for root in "$HOME/dev" "$HOME/projects"; do
      if [ -d "$root" ]; then
        find "$root" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | sort
      fi
    done
    find "$HOME" -maxdepth 2 -mindepth 1 \
      \( -name '.*' -o -name yay \) -prune -o -type d -print | sort
  } | awk '!seen[$0]++'
}

if [ "${1:-}" = "--list" ]; then
  collect_candidates
  exit 0
fi

selection=""
if command -v fzf >/dev/null 2>&1; then
  selection="$(collect_candidates | fzf --prompt="▲ sesh ▸ " --height=45% --layout=reverse --border=rounded || true)"
else
  echo "Selecione uma sessão/diretório:"
  mapfile -t items < <(collect_candidates)
  select item in "${items[@]}"; do
    selection="${item:-}"
    break
  done
fi

[ -z "$selection" ] && exit 0

if [[ "$selection" == "[tmux] "* ]]; then
  sess_name="${selection#\[tmux\] }"
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "$sess_name"
  else
    exec tmux attach-session -t "$sess_name"
  fi
else
  exec "$(dirname "${BASH_SOURCE[0]}")/workbench" code "$selection"
fi
